scene:
  light_dir: "@vec3(-0.5,-1,-0.2)"
  light_color: "@vec3(1,1,1)"
  entities[4]:
    - id: Skybox
      visible: true
      transform:
        scale: "@vec3(10,10,10)"
      mesh: @primitive(cube)
      material:
        shader: skybox
        base_color: "@color(1,1,1,1)"
        roughness: 0.5
        metallic: 0
    - id: node_damagedHelmet_-6514
      visible: true
      transform:
        rot: "@quat(0.707107,0,0,0.707107)"
      mesh: "@asset(assets://models/gltf/DamagedHelmet.glb)"
      material:
        shader: pbr
        base_color: "@color(1,1,1,1)"
        roughness: 1
        metallic: 1
        albedo: embedded_img_0
        normal: embedded_img_4
        metallic_roughness: embedded_img_1
        ao: embedded_img_3
        emissive: embedded_img_2
    - id: Cube
      visible: true
      mesh: "@asset(assets://models/gltf/cube.glb)"
      material:
        shader: pbr
        base_color: "@color(1,1,1,1)"
        roughness: 0.5
        metallic: 0
        albedo: CubeTexture
    - id: ChildCube
      visible: true
      parent: @entity(Cube)
      transform:
        pos: "@vec3(-1.5,0,0)"
        scale: "@vec3(0.5,0.5,0.5)"
      mesh: "@asset(assets://models/gltf/cube.glb)"
      material:
        shader: pbr
        base_color: "@color(1,1,1,1)"
        roughness: 0.5
        metallic: 0
        albedo: CubeTexture